          "raw": "{\n  \"licenseToken\": \"{{license_token}}\",\n  \"installationFingerprint\": \"fp_wrong_installation_9ef898dd4b3d4c7eb91bb6c64a6b5f55\",\n  \"currentLicenseVersion\": {{current_license_version}},\n  \"appVersion\": \"0.1.0\",\n  \"usage\": {\n    \"projects\": 1,\n    \"users\": 2,\n    \"monthlyEvents\": 100\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/licenses/check-in",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "licenses",
            "check-in"
          ]
        }
      }
    }
  ],
